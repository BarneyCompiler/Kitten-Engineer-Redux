<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <KsaDirectory Condition="'$(KsaDirectory)' == ''">C:\Program Files\Ahwoo\Games\Kitten Space Agency</KsaDirectory>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="KSA_Source/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- KSA and StarMap supply these assemblies at runtime. -->
        <PackageReference Include="CommunityToolkit.HighPerformance" Version="8.4.2" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="StarMap.API" Version="0.5.4" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="KSA">
            <HintPath>$(KsaDirectory)/KSA.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="BepuUtilities">
          <HintPath>$(KsaDirectory)/BepuUtilities.dll</HintPath>
          <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.Core">
          <HintPath>$(KsaDirectory)/Brutal.Core.dll</HintPath>
          <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.Logging">
          <HintPath>$(KsaDirectory)/Brutal.Logging.dll</HintPath>
          <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.Numerics">
            <HintPath>$(KsaDirectory)/Brutal.Numerics.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.Glfw">
            <HintPath>$(KsaDirectory)/Brutal.Glfw.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.ImGui">
            <HintPath>$(KsaDirectory)/Brutal.ImGui.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.ImGui.Extensions">
            <HintPath>$(KsaDirectory)/Brutal.ImGui.Extensions.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Brutal.Strings">
            <HintPath>$(KsaDirectory)/Brutal.Strings.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Update="mod.toml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="DeployMod" AfterTargets="Build" Condition="'$(ModDeployDir)' != ''">
        <ItemGroup>
            <ModFiles Include="$(TargetPath);$(TargetDir)$(AssemblyName).deps.json;$(TargetDir)mod.toml" />
        </ItemGroup>
        <MakeDir Directories="$(ModDeployDir)" />
        <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModDeployDir)" />
        <Message Importance="High" Text="Mod successfully deployed to: $(ModDeployDir)" />
    </Target>
</Project>
